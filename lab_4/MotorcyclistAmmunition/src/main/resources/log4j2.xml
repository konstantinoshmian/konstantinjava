<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Путь к папке, где будут лежать файлы логов -->
        <Property name="baseDir">logs</Property>
    </Properties>

    <Appenders>
        <!-- 1. НАСТРОЙКА КОНСОЛИ С ЦВЕТАМИ (%highlight) -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout disableAnsi="false" pattern="%d{HH:mm:ss.SSS} [%t] %highlight{%-5level}{FATAL=red, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan} %logger{36} - %msg%n"/>

        </Console>

        <!-- 2. ФАЙЛ ДЛЯ INFO ЛОГОВ (Текущий + Архивация) -->
        <RollingFile name="InfoFileAppender"
                     fileName="${baseDir}/info.log"
                     filePattern="${baseDir}/archive/info-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Filters>
                <!-- Пропускает только уровень INFO -->
                <ThresholdFilter level="WARN" onMatch="DENY" onMismatch="NEUTRAL"/>
                <ThresholdFilter level="INFO" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB"/> <!-- Архивация при достижении 10МБ -->
            </Policies>
        </RollingFile>

        <!-- 3. ФАЙЛ ДЛЯ WARN ЛОГОВ (Текущий + Архивация) -->
        <RollingFile name="WarnFileAppender"
                     fileName="${baseDir}/warn.log"
                     filePattern="${baseDir}/archive/warn-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Filters>
                <!-- Пропускает только уровень WARN -->
                <ThresholdFilter level="ERROR" onMatch="DENY" onMismatch="NEUTRAL"/>
                <ThresholdFilter level="WARN" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
        </RollingFile>

        <!-- 4. ФАЙЛ ДЛЯ ERROR ЛОГОВ (Текущий + Архивация) -->
        <RollingFile name="ErrorFileAppender"
                     fileName="${baseDir}/error.log"
                     filePattern="${baseDir}/archive/error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10 MB"/>
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="InfoFileAppender"/>
            <AppenderRef ref="WarnFileAppender"/>
            <AppenderRef ref="ErrorFileAppender"/>
        </Root>
    </Loggers>
</Configuration>
